<section class="relative">
    <div class="container px-4 mx-auto">
        <div class="relative flex flex-wrap -mx-4">
            <div class="w-full lg:w-1/3 pt-20 px-4 max-w-lg lg:max-w-full mx-auto lg:mx-0 text-center lg:text-left">
                <a class="inline-block mx-auto lg:ml-0 text-3xl font-semibold leading-none mb-2" href="index.html">{% set variant = 'pink' %}{% set lazy = true %}{% include "blocks/logo.twig" %}</a>
                <p class="text-xs">© 2021-2024. All rights reserved.</p>
            </div>
            <div class="relative w-full lg:w-2/3 px-4 py-8 lg:pt-10 lg:pl-12">
                <div class="footer-links" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; align-items: start; width: 100%;">

                    <div class="footer-links__column">
                        <h5 class="mb-4 text-lg font-bold">{{ t.footer.empathy_holdings_products }}</h5>
                        <ul class="space-y-3">
                            <li><a class="as-primary-color" target="_blank" rel="noopener noreferrer" href="https://visibleprivacy.com/">{{ t.footer.visible_privacy }}</a></li>
                            <li><a class="as-primary-color" target="_blank" rel="noopener noreferrer" href="https://motive.co">{{ t.footer.motive_search_plugin }}</a></li>
                            <li><a class="as-primary-color" target="_blank" rel="noopener noreferrer" href="https://empathy.co">{{ t.footer.empathy_platform }}</a></li>
                            <li><a class="as-primary-color" target="_blank" rel="noopener noreferrer" href="https://empathy.ai">{{ t.footer.empathy_ai }}</a></li>
                        </ul>
                    </div>
                    <div class="footer-links__column">
                        <h5 class="mb-4 text-lg font-bold">{{ t.footer.integrations }}</h5>
                        <ul class="space-y-3">
                            <li><a href="{{ url("prestashop") }}">Prestashop</a></li>
                            <li><a href="{{ url("shopify") }}">Shopify</a></li>
                            <li><a href="{{ url("woocommerce") }}">Woocommerce</a></li>
                            <li><a href="{{ url("google_shopping") }}">Google Shopping</a></li>
                            <li><a href="{{ url("mabisy") }}">Mabisy</a></li>
                        </ul>
                    </div>
                    <div class="footer-links__column">
                        <h5 class="mb-4 text-lg font-bold">{{ t.footer.resources }}</h5>
                        <ul class="space-y-3">
                            <li><a class="as-primary-color" target="_blank" href="https://apisearch.io/blog">Blog</a></li>
                            <li><a class="as-primary-color" target="_blank" href="https://www.linkedin.com/company/18418235">Linkedin</a></li>
                            <li><a class="as-primary-color" target="_blank" href="https://twitter.com/apisearchio">Twitter</a></li>
                        </ul>
                    </div>
                    <div class="footer-links__column">
                        <h5 class="mb-4 text-lg font-bold">{{ t.footer.company }}</h5>
                        <ul class="space-y-3">
                            <li><a class="as-primary-color" href="#contact">{{ t.footer.contact }}</a></li>
                            <li><a class="as-primary-color" href="/assets/terms-and-conditions/terms-and-conditions-{{ language }}.pdf">{{ urlname("terms_and_conditions") }}</a></li>
                            <li><a class="as-primary-color" href="{{ url("privacy_policy") }}">{{ urlname("privacy_policy") }}</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
